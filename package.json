{
	"name": "@andrextor_ia11012/placetopay-core",
	"version": "1.0.0",
	"description": "A lightweight, type-safe SDK for seamless integration with Placetopay services.",
	"type": "module",
	"author": "Iván Andrés López. <ialopez11012@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/andrextor/placetopay-core/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/andrextor/placetopay-core.git"
	},
	"bugs": {
		"url": "https://github.com/andrextor/placetopay-core/issues"
	},
	"keywords": [
		"placetopay",
		"payments",
		"sdk",
		"typescript",
		"gateway",
		"colombia",
		"checkout"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check": "biome check .",
		"check:apply": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"prepublishOnly": "npm run build && npm run test:run"
	},
	"dependencies": {
		"ofetch": "^1.5.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@types/node": "^25.2.2",
		"@vitest/coverage-v8": "^4.0.18",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
